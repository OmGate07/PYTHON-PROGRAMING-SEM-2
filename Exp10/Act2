import streamlit as st

st.set_page_config(page_title="BMI Health Checker", page_icon="⚖️")

st.title("⚖️ BMI Health Checker")
st.write("Calculate your Body Mass Index to monitor your health status.")

# Input Section
col1, col2 = st.columns(2)

with col1:
    weight = st.number_input("Enter your weight (in kg):", min_value=1.0, step=0.1, value=70.0)

with col2:
    height_cm = st.number_input("Enter your height (in cm):", min_value=50.0, step=0.1, value=170.0)

if st.button("Calculate BMI"):
    # Convert height to meters
    height_m = height_cm / 100
    
    # Calculate BMI
    bmi = weight / (height_m ** 2)
    bmi = round(bmi, 2)
    
    st.markdown("---")
    st.subheader(f"Your BMI is: {bmi}")
    
    # Logic for Classification
    if bmi < 18.5:
        st.warning("Category: Underweight")
        st.info("💡 Tip: Consider consulting a nutritionist to help you gain healthy weight.")
    elif 18.5 <= bmi < 25:
        st.success("Category: Normal weight")
        st.info("💡 Tip: Great job! Maintain your current balanced diet and exercise routine.")
    elif 25 <= bmi < 30:
        st.warning("Category: Overweight")
        st.info("💡 Tip: Try increasing physical activity and monitoring calorie intake.")
    else:
        st.error("Category: Obese")
        st.info("💡 Tip: It is recommended to speak with a healthcare provider for a personalized plan.")
